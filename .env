# Strapi CMS Configuration
# Copy this file to .env and fill in your actual values

# Strapi API URL (local development)
VITE_CMS_URL=http://localhost:1337/api

# Strapi API Token (get from Strapi admin panel)
VITE_CMS_TOKEN=your_strapi_api_token_here

# Optional: Preview mode settings
VITE_CMS_PREVIEW_ENABLED=false